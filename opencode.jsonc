{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "github-copilot"
  ],

  "model": "github-copilot/claude-sonnet-5.5",
  "agent": {
    "command-summarizer": {
      "model": "github-copilot/claude-haiku-5.5"
    }
  },
  // Load only the root shared guidance globally; package-specific AGENTS.md files are referenced from there.
  "instructions": [
    "AGENTS.md"
  ],
  "share": "disabled",
  // Playwright MCP is off by default; enable it on demand via /mcp and use the ui-reviewer agent.
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "env",
        "-u",
        "KEYCLOAK_READER_PASSWORD",
        "npx",
        "--offline",
        "--yes",
        "@playwright/mcp@0.0.86",
        "--isolated",
        "--storage-state={env:HOME}/.cache/dataland-playwright/reader.json",
        "--redact-url-params=access_token,code,session_state",
        "--ignore-https-errors"
      ],
      "enabled": false
    }
  },
  "permission": {
    "webfetch": "ask",
    "bash": {
      "git push --force*": "deny",
      "git push*": "ask",
      "git reset*": "ask"
    }
  },
  // Large monorepo: preserve more room for compaction and ignore noisy generated folders.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      ".opencode/node_modules/**",
      "**/node_modules/**",
      "**/build/**",
      "**/coverage/**",
      "log/**"
    ]
  }
}
